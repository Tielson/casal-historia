STRIPE_CURRENCY=brl

# Storage (S3-compatible / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=entre-nos
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Generation
MOCK_GENERATION=true
MAX_PREVIEW_REGENS=3
OPENAI_API_KEY=
IMAGE_PROVIDER_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Entre Nós <noreply@entrenos.app>

# Meta Pixel + CAPI
