# === Shared / API ===
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Turso / libSQL (preferred database)
# Create: turso db create casal-historia && turso db show --url casal-historia
# Token:  turso db tokens create casal-historia
TURSO_DATABASE_URL=libsql://casal-historia-ORG.turso.io
TURSO_AUTH_TOKEN=

# Local SQLite for prisma migrate / db push when Turso is unavailable
DATABASE_URL=file:./prisma/dev.db
# Deprecated — Postgres is no longer used (switched to Turso/libSQL):
# DATABASE_URL=postgresql://entrenos:entrenos@localhost:5432/entrenos

REDIS_URL=redis://localhost:6379

# Auth / ops
ADMIN_TOKEN=change-me-admin-token
DRAFT_COOKIE_NAME=en_draft

# Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CENTS=4990
STRIPE_CURRENCY=brl

# Storage (S3-compatible — Cloudflare R2 preferred; MinIO ok for local)
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  |  region=auto  |  leave S3_PUBLIC_BASE_URL empty for private signed GETs
# MinIO: http://localhost:9000  |  region=us-east-1  |  access/secret=minioadmin
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nos-dois
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
# Optional Cloudflare API (bucket admin only; never commit real values)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Generation
MOCK_GENERATION=true
MAX_PREVIEW_REGENS=3
OPENAI_API_KEY=
IMAGE_PROVIDER_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Entre Nós <noreply@entrenos.app>

# Meta Pixel + CAPI
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=false

# === Web (Next.js public) ===
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PRICE_LABEL=R$ 49,90
